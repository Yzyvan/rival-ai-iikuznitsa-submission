{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "strict": true, "types": ["vite/client"], "skipLibCheck": true, "noEmit": true,
    "isolatedModules": true, "resolveJsonModule": true, "allowImportingTsExtensions": false
  },
  "include": ["src"]
}
